# All optional — the game works fully without these.
# Supabase (analytics/aggregate stats only). Leave blank to disable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog (analytics). Leave blank to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public site URL (used for OG tags + share card footer)
NEXT_PUBLIC_SITE_URL=https://play.crux8.com

# Where the Crux8 CTA links to
NEXT_PUBLIC_CRUX8_URL=https://crux8.com
